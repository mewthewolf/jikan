{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jikan",
  "version": "0.1.0",
  "identifier": "com.mewthewolf.jikan",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Jikan",
        "width": 1180,
        "height": 820,
        "minWidth": 880,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false
  }
}
